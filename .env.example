# Copy to .env and fill in. .env is gitignored -- never commit real keys.

# Deployer key. The value below is anvil's first account: public, prefunded,
# and safe only on a local node. Replace it for anything else.
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# RPC endpoints
RPC_URL_LOCAL=http://127.0.0.1:8545
RPC_URL_SEPOLIA=

# Optional deploy parameters. Unset values fall back to the deployer / zero.
TREASURY=
PROVENANCE_HASH=
ALLOWLIST_ROOT=

# Input file for `make allowlist`
ALLOWLIST_FILE=./allowlist.json

# For `forge verify-contract` after a public deployment
ETHERSCAN_API_KEY=
